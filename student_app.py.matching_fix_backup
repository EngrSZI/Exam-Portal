function updateStats(){if(!exam)return;let n=exam.questions.filter(answered).length;$('answeredCount').textContent=n;$('remainingCount').textContent=exam.questions.length-n;$('progressBar').style.width=(100*n/exam.questions.length)+'%';exam.questions.forEach((question,i)=>{const b=$('num'+i);if(!b)return;b.className='qnum'+(answered(question)?' answered':'')+(flags.has(question.id)?' review':'')+(i===idx?' current':'')});$('footProgress').textContent=`Question ${idx+1} of ${exam.questions.length}`}
function asset(path){if(!path)return '';const value=String(path);if(/^data:image\//i.test(value)||/^https?:\/\//i.test(value)||value.startsWith('file:///'))return value;return 'file:///'+value.replace(/\\/g,'/').replace(/^\//,'').split('/').map((p,i)=>i===0&&p.endsWith(':')?p:encodeURIComponent(p)).join('/')}
function imageHtml(path,cls='question-image'){return path?`<img class="${cls}" src="${asset(path)}" onclick="event.stopPropagation();zoomImage(this.src)" alt="Question image" title="Click to zoom">`: ''}

function parseMatchingPrompt(prompt){
    const lines=String(prompt||'').split(/\r?\n/);
    let section='';
    const descriptions=[];
    const choices=[];
    for(const raw of lines){
        const line=raw.trim();
        if(line==='DESCRIPTIONS'){section='descriptions';continue}
        if(line==='ANSWER BANK'){section='choices';continue}
        if(section==='descriptions'){
            const m=line.match(/^([A-Z]{1,2})\.\s+(.+)$/);
            if(m)descriptions.push({id:m[1],text:m[2]});
        }else if(section==='choices'){
            const m=line.match(/^(\d+)\.\s+(.+)$/);
            if(m)choices.push({id:m[1],text:m[2]});
        }
    }
    return {descriptions,choices};
}
function matchingMap(value){
    const result={};
    String(value||'').split(';').forEach(part=>{
        const m=part.trim().match(/^([A-Z]{1,2})\s*=\s*(\d+)$/);
        if(m)result[m[1]]=m[2];
    });
    return result;
}
function matchingInterface(question){
    const parsed=parseMatchingPrompt(question.prompt);
    const descriptions=parsed.descriptions;
    const choices=parsed.choices;
    if(!descriptions.length||!choices.length){
        return `<p class="muted">This matching question could not be read. Please contact the instructor.</p>
        <label class="muted small">Enter matches manually</label>
        <input class="answer-input" id="textAnswer" value="${esc(answers[question.id]||'')}" oninput="setTextAnswer(this.value)">`;
    }
    const matches=matchingMap(answers[question.id]||'');
    if(!window.matchingSelectedLabel||!descriptions.some(d=>d.id===window.matchingSelectedLabel))
        window.matchingSelectedLabel=descriptions.find(d=>!matches[d.id])?.id||descriptions[0].id;
    const selected=window.matchingSelectedLabel;
    let html=`<p class="muted">Select a description on the left, then select its matching answer on the right. Select another description to change a match.</p>
    <div class="matching-layout">
    <div class="matching-column"><h4>Descriptions (${descriptions.length})</h4>`;
    for(const d of descriptions){
        const chosen=matches[d.id];
        html+=`<button type="button" class="matching-card ${selected===d.id?'matching-active':''} ${chosen?'matching-done':''}" onclick="chooseMatchingLabel('${d.id}')">
        <span class="matching-code">${d.id}</span><span class="matching-description">${esc(d.text)}</span>
        <span class="matching-pair">${chosen?'Matched: '+esc(chosen):'Select answer'}</span></button>`;
    }
    html+=`</div><div class="matching-column"><h4>Answer bank (${choices.length})</h4>`;
    for(const c of choices){
        const usedBy=Object.keys(matches).find(k=>matches[k]===c.id);
        const isCurrent=matches[selected]===c.id;
        html+=`<button type="button" class="matching-card ${isCurrent?'matching-active':''} ${usedBy?'matching-used':''}" onclick="assignMatchingAnswer('${c.id}')">
        <span class="matching-code">${c.id}</span><span class="matching-description">${esc(c.text)}</span>
        <span class="matching-pair">${isCurrent?'Matched to '+selected:usedBy?'Used by '+esc(usedBy):'Click to match '+selected}</span></button>`;
    }
    const count=Object.keys(matches).length;
    html+=`</div></div><div class="matching-summary">${count} of ${descriptions.length} descriptions matched</div>`;
    return html;
}
function chooseMatchingLabel(label){
    window.matchingSelectedLabel=label;
    renderQuestion();
}
function assignMatchingAnswer(answerId){
    const question=q();
    if(!question||question.type!=='matching')return;
    const parsed=parseMatchingPrompt(question.prompt);
    const selected=window.matchingSelectedLabel;
    if(!selected)return;
    const matches=matchingMap(answers[question.id]||'');
    const existingOwner=Object.keys(matches).find(k=>matches[k]===answerId&&k!==selected);
    if(existingOwner){
        toast('This answer is already matched to '+existingOwner+'. Select a different answer.');
        return;
    }
    matches[selected]=answerId;
    const ordered=parsed.descriptions
        .filter(d=>matches[d.id])
        .map(d=>d.id+'='+matches[d.id]);
    setTextAnswer(ordered.join('; '));
    const next=parsed.descriptions.find(d=>!matches[d.id]);
    window.matchingSelectedLabel=next?next.id:selected;
    renderQuestion();
}

function renderQuestion(){const question=q();const type=question.type;let html=`<div class="qmeta"><span class="pill">Week ${esc(question.week??'—')}</span><span class="pill gray">${esc(type.replace('_',' '))}</span><span class="marks">${esc(question.marks??1)} mark(s)</span></div><h3 class="prompt">${esc(question.prompt)}</h3>${imageHtml(question.image)}<div class="answer-area">`;
if(['mcq','image_mcq','true_false','fill_blank'].includes(type)){let opts=question.options||[{id:'true',text:'True'},{id:'false',text:'False'}];html+=opts.map(o=>`<div role="radio" aria-checked="${String(answers[question.id]??'')===String(o.id)}" tabindex="0" class="option ${String(answers[question.id]??'')===String(o.id)?'selected':''}" data-question-id="${esc(question.id)}" data-option-id="${esc(String(o.id))}" onclick="selectOptionElement(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectOptionElement(this)}"><span class="radio"></span><div><b>${esc(o.id)}.</b> ${esc(o.text||'')}${imageHtml(o.image,'opt-img')}</div></div>`).join('')}
else if(type==='short_answer'){html+=`<label class="muted small">Your response · concise explanation</label><textarea id="textAnswer" placeholder="Write your answer here…" oninput="setTextAnswer(this.value)">${esc(answers[question.id]||'')}</textarea>`}
else if(type==='matching'){html+=matchingInterface(question)}
else{html+=`<label class="muted small">Your answer</label><input class="answer-input" id="textAnswer" value="${esc(answers[question.id]||'')}" placeholder="Type your answer…" oninput="setTextAnswer(this.value)">`}
html+='</div>'; $('questionCard').innerHTML=html;$('prevBtn').disabled=idx===0;$('nextBtn').textContent=idx===exam.questions.length-1?'Go to review →':'Save & next →';$('reviewBtn').textContent=flags.has(question.id)?'★ Remove review flag':'☆ Mark for review';updateStats()}
function selectOptionElement(el){if(!el)return;setAnswer(el.dataset.questionId,el.dataset.optionId)}
function setAnswer(id,val){answers[id]=val;persist();renderQuestion();}function setTextAnswer(val){answers[q().id]=val;persist();updateStats()}
function persist(){pywebview.api.save_draft({answers,flags:[...flags],idx,deadline}).then(()=>{$('saveStatus').textContent='✓ Saved locally';}).catch(()=>{$('saveStatus').textContent='Local save pending';});updateStats()}
function navigate(delta){if(idx+delta<0)return;if(idx+delta>=exam.questions.length){showReview();return}idx+=delta;persist();renderQuestion()}function goTo(i){idx=i;renderQuestion();persist()}function toggleReview(){const id=q().id;if(flags.has(id))flags.delete(id);else flags.add(id);persist();renderQuestion();toast(flags.has(id)?'Marked for review':'Review flag removed')}
function showReview(){if(!exam)return;$('examView').classList.add('hidden');$('reviewView').classList.remove('hidden');let n=exam.questions.filter(answered).length;$('reviewAnswered').textContent=n;$('reviewUnanswered').textContent=exam.questions.length-n;$('reviewList').innerHTML=exam.questions.map((question,i)=>`<div class="review-item"><h4>Question ${i+1} ${flags.has(question.id)?' · ⚑ Review':''}</h4><p>${esc(question.prompt.slice(0,140))}${question.prompt.length>140?'…':''}</p><div class="muted small">${answered(question)?'Answered':'Unanswered'} · ${esc(question.marks??1)} mark(s)</div><button class="secondary" style="margin-top:12px" onclick="goReviewQuestion(${i})">${answered(question)?'Review answer':'Answer question'}</button></div>`).join('')}
