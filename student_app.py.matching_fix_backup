class StudentBridge:
    def __init__(self):
        self.exam = None
        self.answers = {}
        self.flags = []
        self.idx = 0
        self.deadline = None
        self.exam_file = None
        self.temp_dir = tempfile.mkdtemp(prefix="agentic_exam_")
        self._window = None

    def choose_exam_file(self):
        """Use pywebview's native dialog, not Tkinter from the JS worker thread."""
        try:
            result = self._window.create_file_dialog(
                webview.OPEN_DIALOG,
                allow_multiple=False,
                file_types=('Exam package (*.exam;*.zip)', 'All files (*.*)'),
            )
            if not result:
                return {"ok": False}
            return {"ok": True, "path": result[0]}
        except Exception as exc:
            return {"ok": False, "error": f"Could not open file picker: {exc}"}

    def choose_submission_path(self, student_id):
        """Open a native Save As dialog for the encrypted submission file."""
        try:
            safe_id = "".join(c if c.isalnum() or c in "-_" else "_" for c in str(student_id)).strip("_") or "student"
            default_name = f"{safe_id}_submission.submission"
            result = self._window.create_file_dialog(
                webview.SAVE_DIALOG,
                save_filename=default_name,
                file_types=("Encrypted submission (*.submission)", "All files (*.*)"),
            )
            if not result:
                return {"ok": False}
            if isinstance(result, (tuple, list)):
                result = result[0] if result else None
            if not result:
                return {"ok": False}
            output_path = Path(result)
            if output_path.suffix.lower() != ".submission":
                output_path = output_path.with_suffix(".submission")
            return {"ok": True, "path": str(output_path)}
        except Exception as exc:
            return {"ok": False, "error": f"Could not open Save As dialog: {exc}"}

    def open_exam(self, path, password):
        if not path or not password:
            return {"ok": False, "error": "Exam file and password are required."}
        try:
            self.exam = open_exam_package(path, password, self.temp_dir)
        except Exception as exc:
            return {"ok": False, "error": f"Cannot open exam: {exc}"}
        self.exam_file = path
        self.answers = {}
        self.flags = []
        self.idx = 0
        duration = int(self.exam.get("duration_minutes", 45)) * 60
        self.deadline = time.time() + duration
        return {
            "ok": True,
            "exam": self._web_exam(self.exam),
            "answers": self.answers,
            "flags": self.flags,
            "remaining_seconds": duration,
        }

    def _web_exam(self, exam):
        data = dict(exam)
        data["questions"] = []
        for q in exam.get("questions", []):
            item = dict(q)
            if item.get("image"):
                image_value = item["image"]
                if isinstance(image_value, str) and image_value.startswith("data:image/"):
                    item["image"] = image_value
                else:
                    item["image"] = str(Path(image_value).resolve())
            item["options"] = [dict(o) for o in item.get("options", [])]
            for option in item["options"]:
                if option.get("image"):
                    image_value = option["image"]
                    if isinstance(image_value, str) and image_value.startswith("data:image/"):
                        option["image"] = image_value
                    else:
                        option["image"] = str(Path(image_value).resolve())
            data["questions"].append(item)
        return data

    def save_draft(self, state):
        self.answers = state.get("answers", self.answers)
        self.flags = state.get("flags", self.flags)
        self.idx = int(state.get("idx", self.idx))
        # The local draft is stored in the app's temporary session directory.
        draft = {
            "answers": self.answers,
            "flags": self.flags,
            "idx": self.idx,
            "saved_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        }
        Path(self.temp_dir, "draft.json").write_text(
            json.dumps(draft, ensure_ascii=False), encoding="utf-8"
        )
        return {"ok": True}

    def submit(self, state):
        if not self.exam:
            return {"ok": False, "error": "No exam is open."}
        self.answers = state.get("answers", self.answers)
        self.flags = state.get("flags", self.flags)
        output_path = state.get("output_path")
        student_id = str(state.get("student_id", "")).strip()
        if not output_path:
            return {"ok": False, "error": "Choose where to save the submission file."}
        if not student_id:
            return {"ok": False, "error": "Student ID is required to submit."}
        output_path = Path(output_path).expanduser().resolve()
        if output_path.suffix.lower() != ".submission":
            output_path = output_path.with_suffix(".submission")
        if not output_path.parent.is_dir():
            return {"ok": False, "error": "The selected destination folder does not exist."}
        if output_path.exists():
            return {"ok": False, "error": "A file already exists at that location. Choose a different filename."}
        public_key_path = self.exam.get("_public_key_path")
        if not public_key_path or not Path(public_key_path).is_file():
            return {
                "ok": False,
                "error": "The instructor public key is missing. Recreate the exam package after generating instructor keys.",
            }
        payload = {
            "schema": 1,
            "attempt_id": str(uuid.uuid4()),
            "student_id": student_id,
            "exam_id": self.exam.get("exam_id", self.exam.get("title", "agentic-midterm")),
            "exam_title": self.exam.get("title", "Agentic AI Midterm"),
            "submitted_at": time.strftime("%Y-%m-%d %H:%M:%S"),
            "answers": self.answers,
            "review_flags": self.flags,
        }
        try:
            encrypted = encrypt_submission(
                json.dumps(payload, ensure_ascii=False).encode("utf-8"),
                public_key_path,
            )
            output_path.parent.mkdir(parents=True, exist_ok=True)
            output_path.write_bytes(encrypted)
            return {"ok": True, "path": str(output_path)}
        except Exception as exc:
            return {"ok": False, "error": f"Could not encrypt submission: {exc}"}


def main():
    bridge = StudentBridge()
    bridge._window = webview.create_window(
        APP_TITLE, html=HTML, js_api=bridge, width=1360, height=900,
        min_size=(900, 650), background_color="#f3f6fb",
    )
    webview.start(debug=False)


if __name__ == "__main__":
    main()
