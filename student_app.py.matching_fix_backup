<script>
let exam=null,answers={},flags=new Set(),idx=0,deadline=0,timerHandle=null,renderToken=0;
const $=id=>document.getElementById(id); const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function toast(msg){$('toast').textContent=msg;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',2200)}
async function openExam(){try{const chosen=await pywebview.api.choose_exam_file();if(!chosen||!chosen.ok||!chosen.path)return;const password=prompt('Enter the exam password:');if(password===null)return;const result=await pywebview.api.open_exam(chosen.path,password);if(!result||!result.ok){if(result&&result.error)alert(result.error);return;}$('welcome').classList.add('hidden');$('examView').classList.remove('hidden');$('timer').classList.remove('hidden');exam=result.exam;answers=result.answers||{};flags=new Set(result.flags||[]);idx=0;deadline=Date.now()+result.remaining_seconds*1000;$('examTitle').textContent=exam.title||'Midterm examination';$('examSub').textContent=(exam.course||'AGENTIC AI SYSTEMS ENGINEERING').toUpperCase();buildPalette();renderQuestion();updateStats();tick();}catch(e){toast('Could not open exam: '+e)}}
function q(){return exam.questions[idx]} function answered(question){return String(answers[question.id]??'').trim().length>0}
